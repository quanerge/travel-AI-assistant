<view class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="index"
    class="tab-item {{selected === index ? 'active' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <image wx:if="{{item.icon}}" class="tab-ico" src="{{selected === index ? item.iconOn : item.icon}}" mode="aspectFit" />
    <text wx:else class="tab-ico tab-emoji">{{item.emoji}}</text>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
