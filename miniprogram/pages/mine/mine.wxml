<!-- pages/mine/mine.wxml -->
<view class="page">
  <view class="card row">
    <view class="avatar">{{userInfo ? userInfo.nickName[0] : '游'}}</view>
    <view style="margin-left:20rpx;">
      <view class="title">{{userInfo ? userInfo.nickName : '游客'}}</view>
      <view class="sub">{{isLogin ? (userInfo.phone || '普通用户') : '普通用户（会员即将上线）'}}</view>
    </view>
  </view>

  <!-- 未登录：引导注册 / 登录 -->
  <view class="card" wx:if="{{!isLogin}}">
    <button class="btn btn-primary btn-block" bindtap="goRegister">登录 / 注册</button>
  </view>

  <!-- 已登录：生日卡片（临近生日高亮，点击编辑资料） -->
  <view class="card birthday-card {{birthdaySoon ? 'birthday-card--soon' : ''}}" wx:if="{{isLogin}}" bindtap="goProfile">
    <view class="birthday-emoji">{{birthdaySoon ? '🎉' : '🎂'}}</view>
    <view class="birthday-body">
      <view class="birthday-title">{{birthdayTip || '我的生日'}}</view>
      <view class="birthday-sub">{{birthday ? ('生日：' + birthday) : '点击设置生日'}} · 点击编辑资料</view>
    </view>
    <text class="sub">></text>
  </view>

  <view class="card menu">
    <view class="menu-item" bindtap="goOrders"><image class="menu-ico" src="/images/mine/orders.png" mode="aspectFit"/><text class="menu-label">我的订单</text><text class="sub">></text></view>
    <view class="menu-item" wx:if="{{isLogin}}" bindtap="goFavorites"><image class="menu-ico" src="/images/mine/star.png" mode="aspectFit"/><text class="menu-label">我的收藏</text><text class="sub">></text></view>
    <view class="menu-item" bindtap="goPlan"><image class="menu-ico" src="/images/mine/plan.png" mode="aspectFit"/><text class="menu-label">智能规划</text><text class="sub">></text></view>
    <view class="menu-item" wx:if="{{isLogin}}" bindtap="goMyConsult"><image class="menu-ico" src="/images/mine/consult.png" mode="aspectFit"/><text class="menu-label">我的咨询<text wx:if="{{unreadCount > 0}}" style="background:#f5222d;color:#fff;font-size:20rpx;min-width:28rpx;height:28rpx;border-radius:14rpx;padding:0 6rpx;margin-left:8rpx;text-align:center;line-height:28rpx;">{{unreadCount > 99 ? '99+' : unreadCount}}</text></text><text class="sub">></text></view>
    <view class="menu-item" wx:if="{{isLogin}}" bindtap="goCoupons"><image class="menu-ico" src="/images/mine/coupons.png" mode="aspectFit"/><text class="menu-label">优惠券</text><text class="sub">></text></view>
    <view class="menu-item" bindtap="goConsult"><image class="menu-ico" src="/images/mine/service.png" mode="aspectFit"/><text class="menu-label">客服中心</text><text class="sub">></text></view>
    <view class="menu-item" bindtap="goAbout"><image class="menu-ico" src="/images/mine/about.png" mode="aspectFit"/><text class="menu-label">关于顾问</text><text class="sub">></text></view>
    <view class="menu-item" wx:if="{{isLogin}}" bindtap="logout"><image class="menu-ico" src="/images/mine/logout.png" mode="aspectFit"/><text class="menu-label">退出登录</text><text class="sub">></text></view>
  </view>

  <view class="card" style="background:#E7F6EF;">
    <view class="title" style="color:var(--primary);">会员即将上线</view>
    <view class="sub">VIP 99/年 · 高级 299/年，享不限 AI 规划、人工咨询免费等权益</view>
  </view>
</view>
