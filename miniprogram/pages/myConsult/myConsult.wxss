/* pages/myConsult/myConsult.wxss */
.page { padding: 24rpx; }
.title { font-size: 34rpx; font-weight: 600; color: #1f2937; }
.sub { display: block; font-size: 24rpx; color: #9ca3af; margin-top: 6rpx; }

.empty { margin-top: 120rpx; display: flex; flex-direction: column; align-items: center; }
.empty-text { color: #9ca3af; margin-bottom: 24rpx; }

.card { background: #fff; border-radius: 16rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); overflow: hidden; }
.card-head { display: flex; justify-content: space-between; align-items: center; padding: 24rpx; }
.head-left { display: flex; align-items: center; }
.channel { font-size: 28rpx; color: #1f2937; font-weight: 500; }
.status { font-size: 22rpx; padding: 2rpx 12rpx; border-radius: 8rpx; margin-left: 16rpx; }
.status-pending { background: #fff7e6; color: #d48806; }
.status-replied { background: #e6f4ff; color: #1677ff; }
.status-done { background: #f6ffed; color: #389e0d; }
.dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #f5222d; margin-left: 12rpx; }
.arrow { font-size: 24rpx; color: #2B7FFF; }

.card-body { border-top: 1rpx solid #f0f0f0; padding: 24rpx; }
.row { display: flex; margin-bottom: 16rpx; }
.label { width: 140rpx; font-size: 26rpx; color: #9ca3af; flex-shrink: 0; }
.value { flex: 1; font-size: 28rpx; color: #374151; line-height: 1.5; }
.reply .value { background: #f6ffed; padding: 16rpx; border-radius: 12rpx; color: #237804; }
.pending-tip { font-size: 26rpx; color: #9ca3af; padding: 8rpx 0; }

/* 行程卡片时间线 */
.block { margin-top: 20rpx; }
.block-title { font-size: 26rpx; color: #1677ff; font-weight: 600; display: block; margin-bottom: 12rpx; }
.iti { display: flex; align-items: flex-start; padding: 12rpx 0; border-left: 4rpx solid #d6e4ff; padding-left: 20rpx; margin-bottom: 8rpx; }
.iti-day { font-size: 24rpx; color: #1677ff; font-weight: 600; width: 64rpx; flex-shrink: 0; }
.iti-main { flex: 1; }
.iti-title { font-size: 28rpx; color: #1f2937; font-weight: 500; display: block; }
.iti-desc { font-size: 25rpx; color: #6b7280; line-height: 1.5; display: block; margin-top: 4rpx; }

/* 附件画廊 */
.gallery { display: flex; flex-wrap: wrap; gap: 12rpx; }
.thumb { width: 200rpx; height: 200rpx; border-radius: 12rpx; background: #f5f5f5; }

/* 一键下单 */
.btn-order { margin-top: 24rpx; background: #ff7a00; color: #fff; border-radius: 12rpx; font-size: 28rpx; }
.btn-primary { background: #2B7FFF; color: #fff; border-radius: 12rpx; font-size: 28rpx; margin-top: 8rpx; }

/* 操作区：下单 + 删除 */
.actions { display: flex; align-items: center; gap: 24rpx; margin-top: 24rpx; }
.link-danger { font-size: 26rpx; color: #f5222d; }
.link-disabled { font-size: 24rpx; color: #bfbfbf; }
