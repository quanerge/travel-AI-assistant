<!-- pages/register/register.wxml -->
<view class="page">
  <view class="card">
    <view class="title">注册成为客户</view>
    <view class="sub">填写资料，享受专属旅行顾问 1v1 服务</view>
  </view>

  <view class="card">
    <view class="field">
      <text class="label">昵称<text class="req">*</text></text>
      <input class="input" placeholder="请输入昵称" value="{{form.nickname}}" data-field="nickname" bindinput="input" />
    </view>
    <view class="field">
      <text class="label">手机号<text class="req">*</text></text>
      <input class="input" type="number" placeholder="请输入手机号" value="{{form.phone}}" data-field="phone" bindinput="input" />
    </view>
    <view class="field">
      <text class="label">微信号</text>
      <input class="input" placeholder="选填，方便顾问联系" value="{{form.wechat_no}}" data-field="wechat_no" bindinput="input" />
    </view>
    <view class="field">
      <text class="label">旅行偏好</text>
      <input class="input" placeholder="选填，如：亲子 / 摄影 / 美食" value="{{form.travel_preference}}" data-field="travel_preference" bindinput="input" />
    </view>
    <view class="field">
      <text class="label">预算区间</text>
      <input class="input" placeholder="选填，如：3000-5000" value="{{form.budget_range}}" data-field="budget_range" bindinput="input" />
    </view>
    <picker mode="date" value="{{form.birthday}}" start="1950-01-01" end="2015-12-31" bindchange="onBirthdayChange">
      <view class="field">
        <text class="label">生日</text>
        <view class="input picker-text">{{form.birthday || '选填，用于生日关怀提醒'}}</view>
      </view>
    </picker>
  </view>

  <button class="btn btn-primary btn-block" loading="{{submitting}}" bindtap="submit">注册并登录</button>
  <view style="height:40rpx;"></view>
</view>
