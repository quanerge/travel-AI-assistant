/* pages/register/register.wxss */
.field { padding: 24rpx 0; border-bottom: 2rpx solid #F0F2F5; }
.field:last-child { border-bottom: none; }
.label { font-size: 28rpx; color: var(--text); display: block; margin-bottom: 12rpx; }
.req { color: var(--danger); margin-left: 6rpx; }
.input {
  height: 72rpx; font-size: 30rpx;
  background: #F7F9FC; border-radius: 12rpx;
  padding: 0 20rpx; box-sizing: border-box;
}
