/* pages/myRecommend/myRecommend.wxss —— 文旅绿主题 */
.page { padding: 24rpx; }
.tip {
  font-size: 24rpx; color: #0E9F6E; background: #E7F6EF;
  padding: 16rpx 20rpx; border-radius: 12rpx; margin-bottom: 20rpx; line-height: 1.5;
}
.empty { text-align: center; color: #909399; padding: 120rpx 40rpx; }
.empty-emoji { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-sub { font-size: 22rpx; color: #B0B7C0; margin-top: 8rpx; }

.card {
  background: #fff; border-radius: 18rpx; padding: 20rpx; margin-bottom: 22rpx;
  box-shadow: 0 4rpx 16rpx rgba(14,159,110,0.06);
}
.head { display: flex; align-items: center; }
.cover { width: 160rpx; height: 160rpx; border-radius: 14rpx; background: #E7F6EF; flex-shrink: 0; }
.head-body { flex: 1; margin-left: 20rpx; position: relative; }
.rname { font-size: 30rpx; font-weight: 600; color: #1f2d3d; padding-right: 120rpx; }
.rmeta { font-size: 24rpx; color: #6B7280; margin-top: 8rpx; }
.badge {
  position: absolute; top: 0; right: 0; font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 20rpx;
}
.badge-pending { background: #ECF5FF; color: #2B7FFF; }
.badge-accepted { background: #E7F6EF; color: #0E9F6E; }
.badge-declined { background: #F4F4F5; color: #909399; }

.hl { margin-top: 18rpx; border-top: 2rpx solid #F0F2F5; padding-top: 16rpx; }
.hl-overview { font-size: 26rpx; color: #374151; line-height: 1.6; }
.hl-title { font-size: 25rpx; font-weight: 600; color: #0E9F6E; margin: 16rpx 0 8rpx; }
.tags { display: flex; flex-wrap: wrap; }
.tag {
  font-size: 22rpx; color: #374151; background: #F5F8F4; border: 2rpx solid #E7F6EF;
  padding: 6rpx 16rpx; border-radius: 20rpx; margin: 0 12rpx 12rpx 0;
}
.tips { padding-left: 4rpx; }
.tip-item { font-size: 23rpx; color: #6B7280; line-height: 1.6; }

.actions { display: flex; gap: 20rpx; margin-top: 18rpx; }
.btn { flex: 1; font-size: 28rpx; border-radius: 30rpx; padding: 14rpx 0; margin: 0; }
.btn-primary { background: linear-gradient(135deg, #0E9F6E, #4FC08D); color: #fff; }
.btn-ghost { background: #F5F8F4; color: #6B7280; border: 2rpx solid #E7F6EF; }
.accepted-note { text-align: center; font-size: 24rpx; color: #0E9F6E; margin-top: 16rpx; }
