/* pages/signup/signup.wxss */
.ri-cover {
  width: 160rpx; height: 120rpx; border-radius: 12rpx; background: #EAF2FF;
  color: var(--primary); text-align: center;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx;
}
.fld {
  display: flex; align-items: center; padding: 24rpx 0;
  border-bottom: 2rpx solid #F0F2F5; font-size: 28rpx;
}
.fld input { flex: 1; margin-left: 24rpx; text-align: right; }
.req { color: var(--danger); margin-right: 8rpx; }
.stepper { flex: 1; display: flex; justify-content: flex-end; align-items: center; }
.step-btn {
  width: 56rpx; height: 56rpx; text-align: center;
  background: #F2F4F8; border-radius: 50%; font-size: 36rpx;
  display: flex; align-items: center; justify-content: center;
}
.step-num { margin: 0 24rpx; min-width: 40rpx; text-align: center; }
.picker { flex: 1; margin-left: 24rpx; text-align: right; color: var(--text-sub); }
