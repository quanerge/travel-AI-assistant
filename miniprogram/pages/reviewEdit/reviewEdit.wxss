/* pages/reviewEdit/reviewEdit.wxss */
.page { padding: 24rpx; }
.stars { display: flex; gap: 16rpx; }
.star { font-size: 60rpx; color: #CBD5CB; line-height: 1; }
.star.on { color: #E5942B; }
.ta {
  width: 100%; height: 200rpx; box-sizing: border-box;
  padding: 16rpx; background: #F5F8F4; border-radius: 12rpx;
  font-size: 28rpx;
}
.imgs { display: flex; flex-wrap: wrap; }
.img {
  width: 160rpx; height: 160rpx; border-radius: 12rpx;
  margin: 0 16rpx 16rpx 0; background: #E7F6EF;
}
.img.add {
  display: flex; align-items: center; justify-content: center;
  color: #0E9F6E; font-size: 64rpx;
  border: 2rpx dashed #0E9F6E; box-sizing: border-box;
}
.submit { margin-top: 24rpx; }
