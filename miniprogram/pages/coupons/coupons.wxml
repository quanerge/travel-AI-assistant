<view class="page">
  <view class="tabs">
    <view class="tab {{tab==='center'?'tab--on':''}}" bindtap="switchTab" data-t="center">领券中心</view>
    <view class="tab {{tab==='mine'?'tab--on':''}}" bindtap="switchTab" data-t="mine">我的优惠券</view>
  </view>

  <!-- 领券中心 -->
  <view wx:if="{{tab==='center'}}">
    <view wx:if="{{claimable.length===0}}" class="empty">暂无可领取的优惠券</view>
    <view wx:for="{{claimable}}" wx:key="id" class="cp-card">
      <view class="cp-amt">¥{{item.amount}}</view>
      <view class="cp-info">
        <view class="cp-title">{{item.title}}</view>
        <view class="cp-sub">{{item.condition || '无门槛'}} · {{item._applicable}}</view>
        <view class="cp-sub">有效期至 {{item._expire}}</view>
      </view>
      <view wx:if="{{item._claimed}}" class="cp-claimed">已领</view>
      <button wx:else class="cp-btn" size="mini" bindtap="onClaim" data-id="{{item.id}}">领取</button>
    </view>
  </view>

  <!-- 我的优惠券 -->
  <view wx:else>
    <view wx:if="{{mine.length===0}}" class="empty">还没有优惠券，去领券中心看看吧</view>
    <view wx:for="{{mine}}" wx:key="id" class="cp-card cp-card--{{item.status}}">
      <view class="cp-amt">¥{{item.amount}}</view>
      <view class="cp-info">
        <view class="cp-title">{{item.title}}</view>
        <view class="cp-sub">{{item.condition || '无门槛'}} · {{item._applicable}}</view>
        <view class="cp-sub">有效期至 {{item._expire}}</view>
      </view>
      <view class="cp-tag">{{item._status}}</view>
    </view>
  </view>
</view>
