/* pages/orderDetail/orderDetail.wxss */
.kv { display: flex; justify-content: space-between; padding: 12rpx 0; border-bottom: 2rpx solid #F4F6F9; }
.steps { display: flex; justify-content: space-between; }
.step { flex: 1; text-align: center; position: relative; }
.step .dot {
  width: 24rpx; height: 24rpx; border-radius: 50%; background: #D8DEE8; margin: 0 auto 8rpx;
}
.step-on .dot { background: var(--primary); }
.step-label { font-size: 20rpx; color: var(--text-sub); }
.step-on .step-label { color: var(--primary); }

/* 线路信息卡片 */
.route-name { font-size: 34rpx; font-weight: 700; color: #1A1A1A; }
.rich { flex: 1; text-align: right; color: #4A4A4A; font-size: 26rpx; line-height: 1.6; white-space: pre-wrap; word-break: break-word; }
/* 让行程说明这类长文本在 kv 内左对齐、可换行 */
.kv .rich { text-align: left; }
.link { color: var(--primary); font-size: 26rpx; }
.itinerary { margin-top: 8rpx; }
.day { display: flex; padding: 12rpx 0; border-bottom: 2rpx solid #F4F6F9; }
.day:last-child { border-bottom: none; }
.day-no { font-size: 24rpx; color: #fff; background: var(--primary); border-radius: 8rpx; padding: 4rpx 10rpx; height: fit-content; margin-right: 16rpx; flex-shrink: 0; }
.day-body { flex: 1; display: flex; flex-direction: column; }
.day-title { font-size: 28rpx; font-weight: 600; color: #1A1A1A; }
.day-content { font-size: 26rpx; color: #4A4A4A; line-height: 1.6; margin-top: 4rpx; white-space: pre-wrap; word-break: break-word; }
