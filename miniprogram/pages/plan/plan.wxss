/* pages/plan/plan.wxss —— 行程规划/线路设计 表单样式 */

/* 顶部主视觉 */
.hero {
  background: linear-gradient(135deg, #0E9F6E, #4FC08D);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
}
.hero-title { font-size: 40rpx; font-weight: 700; }
.hero-sub { font-size: 24rpx; opacity: .92; margin-top: 12rpx; }

/* 表单卡片 */
.form-card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 4rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 行式字段（下拉类） */
.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: 2rpx solid #F0F2F5;
}
.field.no-border { border-bottom: none; }
.field-label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  flex-shrink: 0;
}
.field-label .req { color: var(--danger); margin-right: 6rpx; }
.field-label .hint {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-sub);
  margin-left: 8rpx;
}

/* 下拉选择器 */
.picker { flex: 1; margin-left: 24rpx; }
.picker-val {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 30rpx;
  color: var(--text);
}
.picker-val.placeholder { color: var(--text-sub); }

/* 文本输入框（联系人 / 手机号） */
.text-input {
  flex: 1;
  margin-left: 24rpx;
  text-align: right;
  font-size: 30rpx;
  color: var(--text);
}
.picker-val .chev {
  color: #C0C4CC;
  font-size: 28rpx;
  margin-left: 12rpx;
}

/* 步进器（最少天数 / 出行人数） */
.stepper { display: flex; align-items: center; }
.step-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #F2F4F8;
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  line-height: 1;
}
.step-btn.disabled { color: #C8CCD4; background: #F7F8FA; }
.step-val {
  min-width: 130rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
}
.step-val .num { font-size: 40rpx; font-weight: 700; color: var(--text); }
.step-val .unit { font-size: 24rpx; color: var(--text-sub); }

/* 兴趣多选 */
.field-block { padding: 30rpx 0 12rpx; }
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 18rpx;
}
.chip {
  padding: 14rpx 30rpx;
  background: #F2F4F8;
  border-radius: 48rpx;
  font-size: 26rpx;
  color: var(--text-sub);
}
.chip-on { background: var(--primary); color: #fff; }

/* 提交区 */
.submit-btn { margin-top: 8rpx; }
.tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-sub);
  margin: 16rpx 0 40rpx;
}

.done { margin-top: 40rpx; }

/* 自定义 tabBar 固定定位，预留底部安全留白，避免内容被遮挡 */
page { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }
