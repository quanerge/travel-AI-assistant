/* pages/index/index.wxss —— 方向A 沉浸杂志风 */
.avatar {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: var(--primary); color: #fff; text-align: center;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx;
}
.col { display: flex; flex-direction: column; }

/* Hero 大图轮播 */
.hero {
  height: 400rpx; border-radius: 24rpx; overflow: hidden;
  margin-bottom: 24rpx; position: relative;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.10);
}
.hero-img { width: 100%; height: 400rpx; display: block; }
.hero-ph { width: 100%; height: 400rpx; background: linear-gradient(135deg, #0E9F6E, #4FC08D); }
.hero-scrim {
  position: absolute; left: 0; right: 0; bottom: 0;
  padding: 40rpx 36rpx 32rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.62), rgba(0,0,0,0));
  color: #fff;
}
.hero-kicker { font-size: 20rpx; letter-spacing: 3rpx; opacity: 0.85; margin-bottom: 10rpx; }
.hero-title {
  font-size: 46rpx; font-weight: 800; line-height: 1.2;
  text-shadow: 0 2rpx 10rpx rgba(0,0,0,0.35);
}
.hero-sub { margin-top: 12rpx; font-size: 24rpx; opacity: 0.92; }

/* 区块标题 */
.sec-head { margin: 8rpx 4rpx 16rpx; }
.sec-title { font-size: 40rpx; font-weight: 800; letter-spacing: 1rpx; }

/* 快捷入口 */
.quick-card { margin-top: 4rpx; }
.quick {
  width: 20%; text-align: center; font-size: 22rpx; color: var(--text-sub);
  display: flex; flex-direction: column; align-items: center;
}
.quick-ico { font-size: 46rpx; margin-bottom: 8rpx; }
