/* pages/index/index.wxss */
.avatar {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: var(--primary); color: #fff; text-align: center;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx;
}
.col { display: flex; flex-direction: column; }
.banner { height: 280rpx; border-radius: 16rpx; overflow: hidden; margin-bottom: 8rpx; position: relative; }
.banner-img { width: 100%; height: 280rpx; display: block; }
.banner-item {
  height: 280rpx; background: linear-gradient(135deg, #2B7FFF, #5AA0FF);
  color: #fff; display: flex; flex-direction: column; justify-content: center;
  padding: 0 40rpx;
}
.banner-mask {
  position: absolute; left: 0; right: 0; bottom: 0; padding: 24rpx 40rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.55), rgba(0,0,0,0));
  color: #fff;
}
.banner-title { font-size: 40rpx; font-weight: 700; }
.banner-sub { margin-top: 12rpx; opacity: 0.9; }

.hot-scroll { white-space: nowrap; }
.route-card {
  display: inline-block; width: 280rpx; background: #fff; border-radius: 16rpx;
  padding: 16rpx; margin-right: 16rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.route-cover {
  width: 100%; height: 160rpx; border-radius: 12rpx;
  background: #EAF2FF; color: var(--primary);
  text-align: center;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx;
}
.cover-ph { background: #EAF2FF; color: var(--primary); }
.route-name { font-weight: 600; margin: 12rpx 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.quick {
  width: 25%; text-align: center; font-size: 24rpx; color: var(--text-sub);
  display: flex; flex-direction: column; align-items: center;
}
.quick-ico { font-size: 48rpx; margin-bottom: 8rpx; }
