<!-- pages/index/index.wxml —— 方向A 沉浸杂志风 -->
<view class="page">
  <!-- 顾问真人形象卡（轻量保留） -->
  <view class="card row advisor" bindtap="goConsult">
    <view class="avatar">{{advisor.name[0]}}</view>
    <view class="col" style="margin-left:20rpx;">
      <view class="title">嗨，我是{{advisor.name}}</view>
      <view class="sub">{{advisor.intro}}</view>
    </view>
    <view class="tag tag-accent" style="margin-left:auto;">咨询</view>
  </view>

  <!-- Hero 大图轮播（沉浸） -->
  <swiper class="hero" indicator-dots indicator-active-color="#ffffff" autoplay circular interval="4000">
    <swiper-item wx:for="{{banners}}" wx:key="id" bindtap="goRoute" data-id="{{item.id}}">
      <image class="hero-img" src="{{item.cover}}" mode="aspectFill" wx:if="{{item.cover && !item._imgErr}}" binderror="onImgError" bindload="onImgLoad" data-id="{{item.id}}" />
      <view class="hero-ph" wx:else></view>
      <view class="hero-scrim">
        <view class="hero-kicker">编辑精选 · EDITOR'S PICK</view>
        <view class="hero-title">{{item.name}}</view>
        <view class="hero-sub">{{item.destination}} · {{item.days}}天 · ¥{{item.price}}起</view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 热门路线（杂志大图卡 2 列） -->
  <view class="row between sec-head">
    <view class="sec-title">热门路线</view>
    <view class="sub" bindtap="goRoute" data-id="">查看全部 ></view>
  </view>
  <view class="route-grid">
    <view class="route-card" wx:for="{{hotRoutes}}" wx:key="id" bindtap="goRoute" data-id="{{item.id}}">
      <image class="route-cover-img" src="{{item.cover}}" mode="aspectFill" wx:if="{{item.cover && !item._imgErr}}" binderror="onImgError" bindload="onImgLoad" data-id="{{item.id}}" />
      <view class="route-ph" wx:else>{{item.destination}}</view>
      <view class="route-scrim">
        <view class="route-name">{{item.name}}</view>
        <view class="route-meta">
          <text>{{item.destination}} · {{item.days}}天</text>
          <text class="route-price">¥{{item.price}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="card quick-card">
    <view class="row wrap">
      <view class="quick" bindtap="goPlan"><view class="quick-ico">🧭</view><text>智能规划</text></view>
      <view class="quick" bindtap="goRoute" data-id=""><view class="quick-ico">🗺️</view><text>热门路线</text></view>
      <view class="quick" bindtap="goConsult"><view class="quick-ico">✍️</view><text>私人定制</text></view>
      <view class="quick" bindtap="goOrders"><view class="quick-ico">📋</view><text>我的订单</text></view>
      <view class="quick" bindtap="goAiChat"><view class="quick-ico">🤖</view><text>AI 助手</text></view>
    </view>
  </view>
</view>
