<!-- pages/routeDetail/routeDetail.wxml -->
<view wx:if="{{route}}" class="detail">
  <!-- 图集/视频 -->
  <swiper class="gallery" indicator-dots>
    <swiper-item wx:for="{{route.gallery.length ? route.gallery : [1]}}" wx:key="*this">
      <view class="gallery-item">{{route.destination}} 风光</view>
    </swiper-item>
  </swiper>

  <view class="page" style="padding-bottom:140rpx;">
    <view class="row between">
      <text class="title">{{route.name}}</text>
      <text class="sub">★ {{route.rating}}</text>
    </view>

    <!-- 成团进度 -->
    <view class="card">
      <view class="row between">
        <text class="sub">已报名 {{route.signup_count}} / 成团 {{route.group_size}} 人</text>
        <text class="{{route.signup_count >= route.group_size ? 'tag tag-success' : 'tag tag-danger'}}">
          {{route.signup_count >= route.group_size ? '已成团' : '招募中'}}
        </text>
      </view>
    </view>

    <view class="row" style="margin:8rpx 0 16rpx;">
      <text class="sub">{{route.departure}}出发 · {{route.days}}天</text>
      <text class="price" style="margin-left:auto;font-size:40rpx;">¥{{route.price}}</text>
    </view>

    <!-- 行程安排 -->
    <view class="card">
      <view class="title" style="margin-bottom:12rpx;">行程安排</view>
      <view class="day" wx:for="{{route.route_days}}" wx:key="day_no" bindtap="toggleDay" data-i="{{index}}">
        <view class="row between">
          <text class="day-title">Day{{item.day_no}} · {{item.title}}</text>
          <text class="sub">{{expandedDay === index ? '收起' : '展开'}}</text>
        </view>
        <view wx:if="{{expandedDay === index}}" class="day-body">
          <view class="sub">{{item.content}}</view>
          <view class="sub">餐饮：{{item.meals}} ｜ 住宿：{{item.accommodation}} ｜ 交通：{{item.traffic}}</view>
        </view>
      </view>
    </view>

    <!-- 费用说明 -->
    <view class="card">
      <view class="title" style="margin-bottom:8rpx;">费用说明</view>
      <view class="sub">包含：{{route.fee_included}}</view>
      <view class="sub" style="margin-top:8rpx;">不含：{{route.fee_excluded}}</view>
    </view>

    <!-- 注意事项 -->
    <view class="card">
      <view class="title" style="margin-bottom:8rpx;">注意事项</view>
      <view class="sub">{{route.notice}}</view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="footer-bar">
    <view class="fav" bindtap="toggleFav">{{favorited ? '★ 已收藏' : '☆ 收藏'}}</view>
    <button class="btn btn-ghost" style="flex:1;" bindtap="goConsult">咨询</button>
    <button class="btn btn-ghost" style="flex:1;" open-type="share">分享</button>
    <button class="btn btn-accent btn-block" style="flex:2;" bindtap="goSignup">立即报名</button>
  </view>
</view>

<view wx:else class="empty">加载中…</view>
