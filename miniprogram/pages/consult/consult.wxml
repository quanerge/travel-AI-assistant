<!-- pages/consult/consult.wxml -->
<view class="page">
  <!-- 真人顾问信息（来自后端 /api/config/advisor，可配置） -->
  <view class="card advisor-card">
    <view class="adv-avatar">{{advisor.name[0] || '顾'}}</view>
    <view class="col" style="flex:1;margin-left:20rpx;min-width:0;">
      <view class="title">顾问 {{advisor.name}}</view>
      <view class="sub" style="margin:6rpx 0;">{{advisor.intro}}</view>
      <view class="sub" wx:if="{{advisor.worktime}}">工作时间：{{advisor.worktime}}</view>
    </view>
  </view>

  <!-- 入口 -->
  <view class="row" style="gap:16rpx;margin-bottom:16rpx;">
    <button class="btn btn-primary" style="flex:1;margin:0;" open-type="contact">微信客服</button>
    <button class="btn btn-ghost" style="flex:1;margin:0;" bindtap="callPhone">电话咨询</button>
  </view>
  <button class="btn btn-ghost btn-block" bindtap="copyWechat" style="margin-bottom:16rpx;">复制顾问微信</button>

  <!-- 在线留言 -->
  <view class="card">
    <view class="title" style="margin-bottom:16rpx;">在线留言</view>
    <input class="msg-in" data-field="name" value="{{form.name}}" bindinput="input" placeholder="称呼（选填）" />
    <input class="msg-in" data-field="phone" value="{{form.phone}}" bindinput="input" type="number" placeholder="手机号（必填）" />
    <textarea class="msg-ta" data-field="content" value="{{form.content}}" bindinput="input" placeholder="请输入您的问题" />
    <button class="btn btn-accent btn-block" bindtap="submitMsg">提交留言</button>
  </view>

  <!-- 常见问题 -->
  <view class="card">
    <view class="title" style="margin-bottom:12rpx;">常见问题</view>
    <view class="faq" wx:for="{{faqs}}" wx:key="q" bindtap="toggle" data-i="{{index}}">
      <view class="row between">
        <text class="faq-q">{{item.q}}</text>
        <text class="sub">{{open === index ? '−' : '+'}}</text>
      </view>
      <view wx:if="{{open === index}}" class="faq-a">{{item.a}}</view>
    </view>
  </view>
</view>
