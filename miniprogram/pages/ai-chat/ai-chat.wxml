<!-- pages/ai-chat/ai-chat.wxml -->
<view class="page">
  <!-- 会话切换条 -->
  <view class="conv-bar">
    <scroll-view scroll-x class="conv-scroll">
      <view class="conv-chip {{item.id === currentId ? 'on' : ''}}"
            wx:for="{{conversations}}" wx:key="id"
            bindtap="selectConv" data-id="{{item.id}}">
        {{item.title || '新对话'}}
      </view>
    </scroll-view>
    <view class="conv-new" bindtap="newConv">+ 新对话</view>
  </view>

  <!-- 消息区 -->
  <scroll-view scroll-y class="msg-scroll" scroll-into-view="{{scrollAnchor}}" scroll-with-animation>
    <view wx:if="{{messages.length === 0}}" class="empty">
      <view class="empty-ico">🤖</view>
      <view class="empty-tip">嗨，我是旅途管家的 AI 旅行助手</view>
      <view class="empty-sub">问问线路、行程或预算，我来帮你规划</view>
    </view>
    <view wx:for="{{messages}}" wx:key="idx" id="m{{index}}"
          class="bubble-row {{item.role === 'user' ? 'me' : 'ai'}}">
      <view class="avatar">{{item.role === 'user' ? '我' : 'AI'}}</view>
      <view wx:if="{{item.role === 'user'}}" class="bubble">{{item.content}}</view>
      <view wx:else class="bubble md">
        <block wx:for="{{item.blocks}}" wx:for-item="b" wx:for-index="bi" wx:key="bi">
          <view wx:if="{{b.type === 'h1'}}" class="md-h md-h1">{{b.text}}</view>
          <view wx:elif="{{b.type === 'h2'}}" class="md-h md-h2">{{b.text}}</view>
          <view wx:elif="{{b.type === 'h3'}}" class="md-h md-h3">{{b.text}}</view>
          <view wx:elif="{{b.type === 'hr'}}" class="md-hr"></view>
          <view wx:elif="{{b.type === 'quote'}}" class="md-quote">{{b.text}}</view>
          <view wx:elif="{{b.type === 'ul'}}" class="md-list">
            <view wx:for="{{b.items}}" wx:for-item="li" wx:for-index="lii" wx:key="lii" class="md-li"><text class="md-bullet">•</text><text class="md-li-text">{{li}}</text></view>
          </view>
          <view wx:elif="{{b.type === 'ol'}}" class="md-list">
            <view wx:for="{{b.items}}" wx:for-item="li" wx:for-index="lii" wx:key="lii" class="md-li"><text class="md-bullet">{{lii + 1}}.</text><text class="md-li-text">{{li}}</text></view>
          </view>
          <view wx:else class="md-p">
            <text wx:for="{{b.parts}}" wx:for-item="p" wx:for-index="pi" wx:key="pi" class="{{p.bold ? 'md-bold' : ''}} {{p.code ? 'md-code' : ''}}">{{p.text}}</text>
          </view>
        </block>
      </view>
    </view>
    <view wx:if="{{loading}}" class="bubble-row ai">
      <view class="avatar">AI</view>
      <view class="bubble typing">正在思考…</view>
    </view>
  </scroll-view>

  <!-- 免责声明 -->
  <view class="disclaimer">AI 建议仅供参考，不构成承诺价格或服务承诺</view>

  <!-- 输入区 -->
  <view class="input-bar">
    <input class="input" value="{{draft}}" bindinput="onInput"
           placeholder="输入你的问题…" confirm-type="send" bindconfirm="send" />
    <view class="send-btn {{draft ? '' : 'disabled'}}" bindtap="send">发送</view>
  </view>
</view>
