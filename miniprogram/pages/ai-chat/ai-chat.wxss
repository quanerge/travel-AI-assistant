/* pages/ai-chat/ai-chat.wxss */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5F7FA;
}

/* 会话切换条 */
.conv-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-bottom: 1rpx solid #ECECEC;
  padding: 12rpx 16rpx;
}
.conv-scroll {
  flex: 1;
  white-space: nowrap;
}
.conv-chip {
  display: inline-block;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 10rpx 22rpx;
  margin-right: 12rpx;
  background: #EEF2F7;
  color: #4B5563;
  border-radius: 30rpx;
  font-size: 24rpx;
}
.conv-chip.on {
  background: #2B7FFF;
  color: #fff;
}
.conv-new {
  flex: none;
  padding: 10rpx 20rpx;
  color: #2B7FFF;
  font-size: 26rpx;
  font-weight: 600;
}

/* 消息区 */
.msg-scroll {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}
.empty {
  text-align: center;
  margin-top: 120rpx;
  color: #9CA3AF;
}
.empty-ico { font-size: 80rpx; }
.empty-tip { font-size: 30rpx; color: #4B5563; margin-top: 16rpx; }
.empty-sub { font-size: 24rpx; margin-top: 8rpx; }

.bubble-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}
.bubble-row.me {
  flex-direction: row-reverse;
}
.avatar {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #2B7FFF;
  color: #fff;
  font-size: 24rpx;
  text-align: center;
  line-height: 64rpx;
}
.bubble-row.ai .avatar { background: #10B981; }
.bubble {
  max-width: 70%;
  margin: 0 16rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-word;
  background: #fff;
  color: #1F2937;
}
.bubble-row.me .bubble {
  background: #2B7FFF;
  color: #fff;
}
.bubble.typing { color: #9CA3AF; }

/* 免责声明 */
.disclaimer {
  text-align: center;
  font-size: 20rpx;
  color: #B0B6BF;
  padding: 8rpx 0;
}

/* 输入区 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fff;
  border-top: 1rpx solid #ECECEC;
}
.input {
  flex: 1;
  height: 72rpx;
  background: #F1F3F6;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}
.send-btn {
  flex: none;
  margin-left: 16rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 32rpx;
  background: #2B7FFF;
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
}
.send-btn.disabled {
  background: #B9CBE6;
}
