/* pages/routes/routes.wxss */
.search { background: #fff; border-radius: 48rpx; padding: 16rpx 32rpx; margin-bottom: 16rpx; }
.search input { font-size: 28rpx; }
.cats { white-space: nowrap; margin-bottom: 16rpx; }
.cat {
  display: inline-block; padding: 10rpx 28rpx; margin-right: 16rpx;
  background: #fff; border-radius: 48rpx; font-size: 26rpx; color: var(--text-sub);
}
.cat-on { background: var(--primary); color: #fff; }

.route-item { display: flex; }
.ri-cover {
  width: 200rpx; height: 160rpx; border-radius: 12rpx; background: #EAF2FF;
  color: var(--primary); text-align: center; font-size: 30rpx; margin-right: 20rpx;
  display: flex; align-items: center; justify-content: center;
}
.ri-body { flex: 1; display: flex; flex-direction: column; }
