<!-- pages/routes/routes.wxml -->
<view class="page">
  <view class="search">
    <text class="search-ico">🔍</text>
    <input placeholder="搜索目的地 / 线路名" value="{{keyword}}" bindinput="onSearch" confirm-type="search" />
  </view>

  <view class="filters">
    <view class="filters-head">
      <text class="filters-title">筛选</text>
      <text class="reset" bindtap="resetFilters">重置</text>
    </view>

    <!-- 行程天数：区间单选 -->
    <view class="fgroup">
      <view class="flabel">行程天数</view>
      <view class="opts">
        <view wx:for="{{dayRanges}}" wx:key="v"
              class="opt {{filters.dayRange === item.v ? 'opt-on' : ''}}"
              data-v="{{item.v}}" bindtap="pickDay">{{item.label}}</view>
      </view>
    </view>

    <!-- 价格区间：区间单选 -->
    <view class="fgroup">
      <view class="flabel">价格区间</view>
      <view class="opts">
        <view wx:for="{{priceRanges}}" wx:key="v"
              class="opt {{filters.priceRange === item.v ? 'opt-on' : ''}}"
              data-v="{{item.v}}" bindtap="pickPrice">{{item.label}}</view>
      </view>
    </view>

    <!-- 出发地：从数据自动提取，单选 -->
    <view class="fgroup">
      <view class="flabel">出发地</view>
      <view class="opts">
        <view wx:for="{{departureOptions}}" wx:key="*this"
              class="opt {{filters.departure === item ? 'opt-on' : ''}}"
              data-v="{{item}}" bindtap="pickDeparture">{{item}}</view>
      </view>
    </view>
  </view>

  <scroll-view scroll-x class="cats">
    <view wx:for="{{categories}}" wx:key="*this"
      class="cat {{activeCat === item ? 'cat-on' : ''}}" data-cat="{{item}}" bindtap="switchCat">
      {{item}}
    </view>
  </scroll-view>

  <view wx:if="{{list.length === 0}}" class="empty">暂无匹配线路</view>

  <view class="route-grid">
    <view class="route-card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <image class="route-cover-img" src="{{item.cover}}" mode="aspectFill" wx:if="{{item.cover && !item._imgErr}}" binderror="onImgError" bindload="onImgLoad" data-id="{{item.id}}" />
      <view class="route-ph" wx:else>{{item.destination}}</view>
      <view class="route-scrim">
        <view class="route-name">{{item.name}}</view>
        <view class="route-meta">
          <text>{{item.destination}} · {{item.days}}天</text>
          <text class="route-price">¥{{item.price}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
