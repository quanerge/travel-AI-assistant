/* pages/guideDetail/guideDetail.wxss —— 攻略阅读页（适老化大字号） */
.gd-head {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.gd-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #1F2937;
  line-height: 1.35;
}
.gd-src-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  flex-wrap: wrap;
}
.gd-src-tag {
  flex-shrink: 0;
  background: #E5942B;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
}
.gd-src-txt {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  color: #9CA3AF;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.gd-copy {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #0E9F6E;
  margin-left: 12rpx;
}

.gd-body {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.gd-h {
  font-size: 34rpx;
  font-weight: 700;
  color: #0E9F6E;
  margin: 24rpx 0 12rpx;
  padding-left: 18rpx;
  border-left: 8rpx solid #0E9F6E;
}
.gd-h:first-child { margin-top: 0; }
.gd-p {
  font-size: 30rpx;
  color: #374151;
  line-height: 1.8;
  margin-bottom: 16rpx;
}
.gd-li {
  display: flex;
  align-items: baseline;
  font-size: 30rpx;
  color: #374151;
  line-height: 1.7;
  margin-bottom: 12rpx;
  padding-left: 8rpx;
}
.gd-dot {
  flex-shrink: 0;
  color: #0E9F6E;
  margin-right: 12rpx;
  font-size: 28rpx;
}
.gd-li-txt { flex: 1; }

.gd-legal {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9CA3AF;
  line-height: 1.6;
  padding-bottom: 40rpx;
}

/* ===== AI 原创改写版（公众号风）===== */
.gd-sum {
  font-size: 32rpx;
  color: #1F2937;
  line-height: 1.8;
  padding: 20rpx 24rpx;
  background: #F0F9F4;
  border-radius: 16rpx;
  margin-bottom: 8rpx;
}
.gd-sec { margin-top: 28rpx; }
.gd-chip {
  display: inline-block;
  background: #E7F6EF;
  color: #0E9F6E;
  font-size: 26rpx;
  padding: 8rpx 22rpx;
  border-radius: 28rpx;
  margin: 0 14rpx 14rpx 0;
  line-height: 1.5;
}
.gd-day {
  border: 2rpx solid #E5EDE8;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
}
.gd-day-t {
  font-size: 30rpx;
  font-weight: 700;
  color: #0E9F6E;
  margin-bottom: 8rpx;
}
.gd-day-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.6;
}
.gd-raw-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx;
  margin: 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #0E9F6E;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.gd-chev {
  margin-left: 10rpx;
  display: inline-block;
  transition: transform 0.2s ease;
}
.gd-chev.on { transform: rotate(180deg); }

/* 自定义 tabBar 固定定位（本页非 tab 页无 tabBar，但保持统一留白） */
page { padding-bottom: 40rpx; }
