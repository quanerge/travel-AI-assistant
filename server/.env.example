# ===== 生产环境变量示例 =====
# 复制为 .env（不要提交真实 .env 到仓库）

# 数据库：生产建议 MySQL；本地调试可用 SQLite
# DATABASE_URL=sqlite:///./lvguanjia.db
DATABASE_URL=mysql+pymysql://lv:lv123@db:3306/lvguanjia?charset=utf8mb4

# CORS：只允许你的小程序/前端域名（逗号分隔）。生产切勿留 "*"
CORS_ORIGINS=https://api.your-domain.com

# 端口（gunicorn 默认 8000，容器内已固定，仅供参考）
PORT=8000
