# 后端环境变量示例（复制为 .env 后填写；.env 已被 gitignore，不会入库）

# ---- 大模型（AI 行程自动规划）----
# 兼容 OpenAI /chat/completions 协议的厂商均可，只改下面三个变量：
#   DeepSeek（推荐，中文好、便宜）:
#     LLM_BASE_URL=https://api.deepseek.com/v1
#     LLM_MODEL=deepseek-chat
#   通义千问 Qwen（阿里，国内稳定）:
#     LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#     LLM_MODEL=qwen-plus
#   OpenAI:
#     LLM_BASE_URL=https://api.openai.com/v1
#     LLM_MODEL=gpt-4o-mini
# ⚠️ 真实 key 只放在 .env（已 gitignore），本 .env.example 仅作示例，禁止写入真实密钥！
LLM_API_KEY=sk-xxxx-your-real-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---- 微信客服回调校验 token（公众平台「消息推送」处填写，需与此一致）----
WECHAT_CALLBACK_TOKEN=lvguanjia_callback

# ---- 微信订阅消息（行前提醒推送，功能3）----
# 在微信公众平台「订阅消息」申请模板，关键词需含：事项(thing1)、处理人(name2)、时间(time3)
# 申请到的模板 ID 填入 WX_SUBSCRIBE_TMPL_ID；appid/secret 在「开发-开发管理-开发设置」获取
WECHAT_APPID=
WECHAT_SECRET=
WX_SUBSCRIBE_TMPL_ID=
# 小程序端同步：miniprogram/utils/config.js 的 subscribeTemplateId 必须填同一个模板 ID

# ---- CORS：管理后台前端地址（逗号分隔）；生产填真实域名 ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 文件型旅游知识库（RAG-lite，零依赖）----
# 知识目录：放 *.md 文件的目录，默认 server/knowledge（相对项目根可写绝对路径）
KNOWLEDGE_DIR=server/knowledge
# 每次检索返回的最相关条数
KNOWLEDGE_TOP_K=3

# ---- 顾问联系方式（一键拨号 / 复制微信，功能2）----
# 前端 /api/config/advisor 读取此处；留空时小程序对应按钮提示「暂未配置」。
# ⚠️ phone 必须是纯数字（如 13800000000），wx.makePhoneCall 才能拨通。
ADVISOR_NAME=小旅顾问
ADVISOR_PHONE=
ADVISOR_WECHAT=
ADVISOR_AVATAR=
ADVISOR_INTRO=资深旅游顾问，提供一对一行程规划与报名服务
ADVISOR_WORKTIME=9:00 - 21:00
